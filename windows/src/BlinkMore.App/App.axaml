<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlinkMore.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#F4F1EA"/>
      <Setter Property="Foreground" Value="#1B1B1B"/>
      <Setter Property="FontFamily" Value="avares://BlinkMore/Assets/Fonts#Noto Sans SC"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#5E655C"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="Foreground" Value="#1F4B3A"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="Button.lang">
      <Setter Property="MinWidth" Value="88"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="#E6E1D6"/>
      <Setter Property="Foreground" Value="#1B1B1B"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.lang.selected">
      <Setter Property="Background" Value="#1F4B3A"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.lang:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#D9D3C6"/>
    </Style>
    <Style Selector="Button.lang.selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#17382B"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#1F4B3A"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="#1F4B3A"/>
    </Style>
    <Style Selector="Button.swatch">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="BorderBrush" Value="#C9C3B6"/>
    </Style>
    <Style Selector="Button.swatch.selected">
      <Setter Property="BorderBrush" Value="#1F4B3A"/>
    </Style>
  </Application.Styles>
</Application>
